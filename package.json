{
  "name": "olcys",
  "version": "0.0.0",
  "private": true,
  "description": "OŁCyŚ (Osintowy łapacz cyfrowych śladów): OSINT tool that links public web traces to crypto addresses and analyses their on-chain activity. HackNation 2026, KAS challenge.",
  "type": "module",
  "scripts": {
    "dev:deps": "docker compose up -d --wait",
    "dev:deps:down": "docker compose down",
    "dev": "pnpm --parallel --filter \"./apps/*\" --filter \"!@olcys/fixture-site\" run dev",
    "dev:fixture": "pnpm --filter @olcys/fixture-site run dev",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "compliance:sources": "node packages/collectors/scripts/sources-doc.ts --check",
    "licenses:check": "pnpm -r --include-workspace-root --no-bail exec license-checker-rseidelsohn --excludePrivatePackages --summary --onlyAllow \"$(node -p \"require('./config/licenses.json').allowed.join(';')\")\"",
    "compliance:sbom": "node scripts/compliance/sbom.ts",
    "licenses:docs": "node scripts/compliance/licenses-doc.ts",
    "compliance:licences": "node scripts/compliance/check-licences.ts",
    "compliance:images": "node scripts/compliance/check-images.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm compliance:licences && pnpm compliance:images && pnpm compliance:sources && pnpm compliance:sbom --check && pnpm licenses:docs --check && pnpm test",
    "db:migrate": "node --env-file-if-exists=.env packages/db/src/migrate.ts",
    "db:status": "node --env-file-if-exists=.env packages/db/src/migrate.ts --status"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "license-checker-rseidelsohn": "5.0.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=26.13.1"
  },
  "packageManager": "pnpm@12.22.0"
}
