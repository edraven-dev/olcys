# Copy to .env and adjust. Never commit .env. Values below are local-development defaults only.

# --- Runtime mode -----------------------------------------------------------
# offline: no internet; fixture site and internal services (Gotenberg, osint-py, local LLM) live,
#          every other host served from recorded cassettes (fixtures/cassettes/<set>), fail on a miss
# replay : everything served from cassettes (fixture pages too); internal services stay live
# live   : real network, restricted to the egress allow-list derived from config/sources.yaml
#          (OLCYS_RECORD=1 records cassettes)
OLCYS_MODE=offline
OLCYS_CASSETTE_SET=demo-v1
OLCYS_RECORD=0
OLCYS_DATA_DIR=./data
OLCYS_COLLECTOR_NAME=dev-analyst
# Egress/proxy IP of this deployment recorded in capture manifests; empty = the first non-internal IPv4 interface address
# (never looked up on the network).
OLCYS_COLLECTOR_IP=
# Largest NTP clock offset (ms) still recorded as a synchronised clock (read from local chrony/systemd, never the network).
OLCYS_CLOCK_MAX_OFFSET_MS=1000
# The analyst recorded with cases, schedule changes, judgements and overrides (falls back to OLCYS_COLLECTOR_NAME,
# then "analyst"); never taken from a request.
OLCYS_ANALYST_NAME=dev-analyst

# --- PostgreSQL (compose.yml) ------------------------------------------------
POSTGRES_DB=olcys
POSTGRES_USER=olcys_owner
POSTGRES_PASSWORD=olcys_owner_dev
POSTGRES_PORT=5432
OLCYS_APP_PASSWORD=olcys_app_dev
# Migrations run as the owner; api/worker connect as the append-only application role.
DATABASE_URL_OWNER=postgres://olcys_owner:olcys_owner_dev@127.0.0.1:5432/olcys
DATABASE_URL=postgres://olcys_app:olcys_app_dev@127.0.0.1:5432/olcys

# --- Local services ---------------------------------------------------------
API_PORT=4000
# Extra Host headers the API accepts besides localhost, 127.0.0.1 and [::1] (any port), comma-separated; a bare name
# allows any port, name:port one port. Requests with another Host get 421 (DNS-rebinding protection); state-changing
# requests from another browser Origin than the web app get 403. Leave empty for the local setup.
OLCYS_API_ALLOWED_HOSTS=
WEB_PORT=5173
FIXTURE_PORT=4100
FIXTURE_VARIANT=v1
# 1 enables POST /__fixture/variant (switch v1/v2 at runtime for the re-run demo, `pnpm demo`). Safe: the fixture site
# serves synthetic data only and listens on loopback. compose reads this file, so re-run `pnpm dev:deps` after changing it.
FIXTURE_ALLOW_VARIANT_SWITCH=1
FIXTURE_SITE_URL=http://127.0.0.1:4100
GOTENBERG_PORT=3100
GOTENBERG_URL=http://127.0.0.1:3100
OSINT_PY_PORT=8090
OSINT_PY_URL=http://127.0.0.1:8090
OLCYS_OSINT_ALLOW_EXTERNAL=false
# Site database used by the Maigret collector: empty = fixture offline/replay, upstream live; fixture | upstream overrides
OSINT_PY_DATABASE=

# --- Periodic re-runs (case schedules, evaluated in the API process) --------
# How often the schedules are checked (seconds)
OLCYS_SCHEDULER_INTERVAL_SECONDS=30
# Minimum interval between scheduled runs in live mode (minutes; politeness towards sources). offline/replay: 1 minute
OLCYS_SCHEDULE_MIN_INTERVAL_MINUTES=60
# Schedule changes are recorded with the analyst from OLCYS_ANALYST_NAME (see above), never from a request

# --- Sandbox chains (compose profile "sandbox"; demo wallets live only here) ---
SANDBOX_ESPLORA_PORT=8094
SANDBOX_ESPLORA_URL=http://127.0.0.1:8094/regtest/api
SANDBOX_ANVIL_PORT=8545
SANDBOX_EVM_RPC_URL=http://127.0.0.1:8545

# --- AI model (any OpenAI-compatible endpoint; swap by changing these) -----
# Default: the OpenVINO Model Server running on this machine (GET /v3/models, POST /v3/chat/completions).
# The model only suggests; suggestions carry zero score weight until an analyst confirms them.
LLM_ENABLED=false
LLM_BASE_URL=http://localhost:2140/v3
LLM_MODEL=qwen3.6-35b-ov
LLM_API_KEY=
# Digest of the served model, recorded with every call (the server does not report it)
LLM_MODEL_DIGEST=
# Entry in config/sources.yaml that the model traffic is attributed to (hosts must be listed there)
LLM_SOURCE_ID=local_llm
LLM_TIMEOUT_MS=60000
# Extra template arguments (JSON object) for servers that support them: thinking off for Qwen on OVMS
LLM_CHAT_TEMPLATE_KWARGS='{"enable_thinking":false}'
# Optional compose profile "llm" (Ollama) as an alternative model server; then LLM_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_PORT=11434
# Optional compose profile "llm-llamacpp" (llama.cpp server) as another swap target: LLM_BASE_URL=http://127.0.0.1:8081/v1
# and LLM_MODEL=<LLAMACPP_ALIAS>. The GGUF file goes to ./data/models; LLM_MODEL_DIGEST=sha256:<sha256sum of the file>.
LLAMACPP_PORT=8081
LLAMACPP_MODEL_FILE=
LLAMACPP_ALIAS=bielik-11b-v3

# --- Third-party API keys (only needed in live mode; each host must be allow-listed) ---
ETHERSCAN_API_KEY=
TRONGRID_API_KEY=
GITHUB_TOKEN=
BRAVE_SEARCH_API_KEY=
MOJEEK_API_KEY=
# CEIDG token: live mode only (offline and replay use the fixture site and need none)
CEIDG_API_TOKEN=

# --- Web search -------------------------------------------------------------
# off      : no search collector
# mock     : search over the fixture site's sitemap only (default; queries never leave the machine)
# external : also Brave / Mojeek, only in live and replay runs, only with a key, and only for cases that enable them
OLCYS_SEARCH_MODE=mock
# true only with a Brave plan whose terms allow storing results; otherwise only rank + URL of each result are kept
BRAVE_SEARCH_STORAGE_RIGHTS=false
# startup (results may be cached for 1 h only: not stored) | business | enterprise
MOJEEK_PLAN=startup

# --- Fund flows -----------------------------------------------------------------
# Hops of counterparties fetched beyond the analysed addresses (each pass is a logged chain fetch; at most 25 addresses
# per hop). 0 disables the expansion; the value is capped at maxHops of config/rules/cashout.v1.yaml (3).
OLCYS_FLOW_EXPANSION_HOPS=1

# --- Report exports (STIX 2.1, MISP, CSV) ------------------------------------
# Name of the producer identity in the STIX bundle (empty: the demo instance name)
OLCYS_STIX_PRODUCER_NAME=
# TLP marking of the exports: white | green | amber | red (default and safest: amber)
OLCYS_EXPORT_TLP=amber

# --- Trusted timestamping (RFC 3161). Only SHA-256 digests are sent. ---------
# Live mode stamps every capture manifest; offline and replay queue the request (no call); `pnpm --filter
# @olcys/worker tsa:flush` retries queued requests in live mode. The TSA host must be in allowedHosts of TSA_SOURCE_ID
# in config/sources.yaml (otherwise the start fails with tsa_host_not_allow_listed).
TSA_ENABLED=true
TSA_URL=https://freetsa.org/tsr
TSA_SOURCE_ID=freetsa
# Optional policy OID to request
TSA_POLICY_OID=
# true only for a qualified TSA from the EU Trusted List (the report then calls the stamp "kwalifikowany")
TSA_QUALIFIED=false
# Comma-separated PEM files with the trust anchors (relative to the repository root)
TSA_TRUST_ANCHORS=config/tsa/freetsa/cacert.pem
TSA_TIMEOUT_MS=10000
# A token whose genTime differs from the collection time by more than this is flagged (skewSuspected)
TSA_MAX_CLOCK_SKEW_SECONDS=120
# Basic authentication for a contracted TSA (secrets: environment only)
TSA_USERNAME=
TSA_PASSWORD=

# --- Telemetry opt-outs (requirement: no data to unapproved external services) ---
DO_NOT_TRACK=1
NEXT_TELEMETRY_DISABLED=1
TURBO_TELEMETRY_DISABLED=1
DOTNET_CLI_TELEMETRY_OPTOUT=1
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
VLLM_NO_USAGE_STATS=1
OLLAMA_NO_CLOUD=1
NPM_CONFIG_UPDATE_NOTIFIER=false

# --- Security ---------------------------------------------------------------
# 1 adds Strict-Transport-Security to API responses; set it only when the API is served over TLS (reverse proxy).
OLCYS_HSTS=0
